{
  "name": "pregonero",
  "version": "0.53.0",
  "description": "Offline lyric/translation projection for macOS",
  "main": "electron/main.cjs",
  "author": "",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5174 && cross-env VITE_DEV_SERVER_URL=http://localhost:5174 electron .\"",
    "dev:single": "cross-env VITE_SINGLE_SCREEN=1 npm run dev",
    "check:main": "node scripts/checkMainProcess.cjs",
    "build": "npm run check:main && vite build",
    "pack": "npm run build && electron-builder --mac",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:warp",
    "test:warp": "node --test src/vendor/warp.test.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.0.0-rc.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^28.1.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.8",
    "vitest": "^4.1.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.changopepper.pregonero",
    "productName": "Pregonero",
    "publish": null,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/vendor/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "afterSign": "build/adhoc-sign.cjs",
    "dmg": {
      "title": "Pregonero",
      "artifactName": "Pregonero-${version}.${ext}"
    }
  }
}
