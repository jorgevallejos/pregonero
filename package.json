{
  "name": "pregonero",
  "version": "1.1.0",
  "description": "Pregonero — the surtitle player. Given a gig, a room and song files, it arms and puts words on shapes until the setlist ends.",
  "author": "",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:warp",
    "test:warp": "node --test src/vendor/warp.test.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^28.1.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
