{
  "name": "live-lyric-translator",
  "version": "0.1.0",
  "description": "Offline lyric/translation projection for macOS",
  "main": "electron/main.cjs",
  "author": "",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
